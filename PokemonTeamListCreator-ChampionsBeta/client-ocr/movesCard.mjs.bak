// JS port of engine.py's "MOVES CARD" section: extracts name/ability/item
// from the left column and up to 4 moves from the right column, applying
// spell-correction/translation and the mega-stone/Rotom-form/Floette
// special cases.
import { groupDetectionsIntoLines, splitLeftRight, dropTinyText } from "./parseStats.mjs";
import {
  spellCorrect, spellCorrectNameConfidence, spellCorrectCandidates, slugify, formatName,
  looksLikeMegaStone, looksLikeMegaStoneRaw, detectRotomForm, resolveFormSuffix,
} from "./spellCorrect.mjs";
import { identifyByAbilityAndMoves, identifyByAbilityAndMovesCandidates } from "./movesetMatch.mjs";
import { baseNativeName, translateToEnglishConfidence } from "./translate.mjs";

// Below this, a fuzzy match is treated as "not confident enough to trust
// silently" for ability/item/move fields and surfaced in the manual-review
// picker instead (see main.mjs) - unlike the name field, these aren't
// affected by the nickname-coincidence problem, so a straightforward fixed
// bar works: a genuine read normally lands at a clean 1.0 (exact or
// devoiced-exact) or, for the handful of fields needing an extra fuzzy pass
// (e.g. Heat Wave's compound dakuten+small-kana misread), still comfortably
// above this once those passes are applied - what's left below it is
// exactly the cases those passes don't already resolve on their own.
const FIELD_CONFIDENCE_THRESHOLD = 0.9;

// idToNameByLang: {name: 'Pokes'|'Items'|'Abilities'|'Moves' -> {lang -> idToName}}
// i.e. idToNameByLang.name.en is pokesEn, idToNameByLang.item.fr is itemsFre, etc.
// Unlike the stats card, nothing this card actually reads (species name,
// ability, item, moves) is ever purely digits - a lone stray number (a
// misread "Lv. 50" indicator or similar page furniture) is always noise
// here, regardless of how tall it renders. This catches cases the height
// filter below can't: a noise token tall enough to survive that filter
// (e.g. "5" at height 60 next to a 138-tall species name, comfortably
// above the 0.35 ratio cutoff) still merged into the name's own row and
// corrupted the match query ("5 Sinistcha" fuzzy-matched to the wrong,
// unrelated "Sinistea" instead of "Sinistcha Masterpiece Form", since the
// stray prefix diluted the ratio against the correct longer entry).
function dropNonWordy(tokens) {
  return tokens.filter((t) => /\p{L}/u.test(t.text));
}

// Same as dropNonWordy, plus the two stray-icon-glyph filters below - scoped
// to the moves (right) column only. Both filters were calibrated against
// icon-misread contamination observed specifically next to move text (see
// their own docstrings); applying them to the left column too was a real
// bug (observed for real: a player nickname of exactly "WP" - a completely
// ordinary short nickname, no different from "GL"/"U2"/"HF" seen on the same
// team - matched isStrayLatinGlyph and was deleted outright, silently
// shifting every row below it up by one, so the ability field read the real
// item text and the item field read nothing at all). The left column's own
// rows aren't at the same risk in the first place: unlike a move name, a
// nickname is never checked against the bundled name list at all (that's
// the whole reason nicknames need the ability+moveset fallback), so
// isStrayLatinGlyph's "no genuine 1-2 character database entry" premise
// doesn't hold for it - a real nickname can be arbitrarily short.
function dropStrayGlyphs(tokens) {
  return tokens.filter((t) => !isStrayLatinGlyph(t.text) && !isStrayLoneGlyph(t));
}

// A move/type-category icon glyph is sometimes misread as a single stray
// CJK character too (observed for real: "心", confidence 0.433, merging
// into the same row as - and corrupting the fuzzy match for - the real
// move text right after it). Unlike isStrayLatinGlyph below, a single real
// CJK character genuinely does appear in the bundled data sometimes (e.g.
// Chinese "抓"/Scratch, "啄"/Peck, Korean "뮤"/Mew), so this can't be a
// blanket length check - it's gated on confidence as well, on the
// assumption that a real, cleanly-rendered single glyph reads with
// meaningfully higher confidence than a small decorative icon does. That's
// a real but imperfect heuristic: a genuinely low-confidence real single-
// character read (rare, but possible for a low-resolution screenshot) could
// still be wrongly dropped here.
function isStrayLoneGlyph(token) {
  return [...token.text.trim()].length === 1 && token.confidence < 0.5;
}

// A move/type-category icon immediately left of the real move text is
// sometimes itself misread as one or two stray Latin letters (observed for
// real: "o", "u", "UP", "U", "MF", "a", "O", "X", "+Y") - short enough to
// survive dropTinyText's height filter (icon bounding boxes aren't
// necessarily short) but not real content: checked against every bundled
// Moves/Items/Abilities/Pokes name in every Latin-script language, there is
// no genuine 1-2 (non-punctuation) character pure-ASCII-letter entry
// anywhere. Left un-filtered, this token merges into the same
// groupDetectionsIntoLines row as the real move text right after it (e.g.
// "o u UP U ドゲザン" instead of just "ドゲザン"), diluting the fuzzy-match
// ratio enough to lose to an unrelated move. Scoped to pure ASCII letters
// specifically (not CJK) since short CJK text is completely normal - many
// real Chinese move/item/species names are exactly 2 characters.
function isStrayLatinGlyph(text) {
  return /^[A-Za-z+]{1,2}$/.test(text.trim());
}

export async function parseMovesCard(tokens, cardWidth, idToNameByLang, lang = "en") {
  const [leftRaw, rightRaw] = splitLeftRight(tokens, cardWidth, 0.45);
  // A looser ratio than the stats card's default: a long ability name
  // (e.g. "Good as Gold") can render noticeably smaller than the species
  // name via auto-shrink-to-fit, which the stats card's tighter 0.6 ratio
  // would wrongly drop as noise here.
  const leftLines = groupDetectionsIntoLines(dropNonWordy(dropTinyText(leftRaw, 0.35)));
  const rightLines = groupDetectionsIntoLines(dropStrayGlyphs(dropNonWordy(dropTinyText(rightRaw, 0.35))));

  // Collects one entry per field the automatic pipeline wasn't confident
  // about, each with the guess actually used plus a few ranked
  // alternatives - surfaced by main.mjs as a single end-of-scan review
  // screen rather than trusting every low-confidence guess silently. Never
  // affects what's returned in name/ability/item/moves themselves - this is
  // purely additional metadata for the caller to act on (or ignore).
  const uncertain = [];

  const nameRaw = leftLines[0]?.text ?? "";
  // Ability/item/moves are parsed ahead of name resolution (rather than
  // after, as their card position would suggest) because a low-confidence
  // name read tries identifying the species from ability+moveset before
  // falling back to the raw fuzzy nickname match - see movesetMatch.mjs.
  // They're plain OCR text reads like any other card field, unaffected by
  // the nickname problem that makes the name field specifically unreliable.
  const abilityRaw = leftLines[1]?.text ?? "";
  let itemRaw = leftLines[2]?.text ?? "";
  itemRaw = itemRaw.replace(/@/g, "").trim();

  let ability = "";
  if (abilityRaw) {
    const idToNameForLang = idToNameByLang.ability[lang];
    const idToNameEnglish = idToNameByLang.ability.en;
    const [, abilityConfidence] = translateToEnglishConfidence(abilityRaw, idToNameForLang, idToNameEnglish, 0.5, "ability");
    ability = spellCorrect(abilityRaw, "ability", idToNameByLang.ability, lang);
    if (abilityConfidence < FIELD_CONFIDENCE_THRESHOLD) {
      uncertain.push({
        field: "ability",
        value: ability,
        candidates: spellCorrectCandidates(abilityRaw, "ability", idToNameByLang.ability, lang),
      });
    }
  }

  const moves = rightLines.slice(0, 4).map((l, i) => {
    const idToNameForLang = idToNameByLang.move[lang];
    const idToNameEnglish = idToNameByLang.move.en;
    const [, moveConfidence] = translateToEnglishConfidence(l.text, idToNameForLang, idToNameEnglish, 0.5, "move");
    const moveName = spellCorrect(l.text, "move", idToNameByLang.move, lang);
    if (moveConfidence < FIELD_CONFIDENCE_THRESHOLD) {
      uncertain.push({
        field: "move",
        index: i,
        value: moveName,
        candidates: spellCorrectCandidates(l.text, "move", idToNameByLang.move, lang),
      });
    }
    return moveName;
  });

  let name = "Unknown";
  if (nameRaw) {
    // A player-chosen nickname - which the game shows in place of the
    // species name, with no species text anywhere else on the card - is
    // still real text in the selected language, so it will often clear
    // the fuzzy-match cutoff against *some* species name by pure
    // coincidence. That's a low-ratio coincidence, not a real read, and is
    // why this checks confidence rather than just whether a match was
    // found at all - see translateToEnglishConfidence's docstring.
    //
    // Only a clean exact/devoiced match (confidence exactly 1.0) is trusted
    // outright - anything else is, by construction, a fuzzy ratio match,
    // which a real nickname can score surprisingly high on by pure
    // coincidence (observed for real: a Japanese nickname scored exactly
    // 0.75 against an unrelated species - comfortably past a naively-picked
    // "0.75 cutoff" - while the ability+moveset fallback independently and
    // correctly identified the real species). Trying the fallback whenever
    // the text match isn't a clean exact hit, rather than gating it behind
    // a fixed fuzzy-ratio threshold, sidesteps needing to guess where
    // exactly that boundary sits: a genuine, slightly OCR-noisy species-name
    // read (which also isn't a clean 1.0) still resolves correctly here
    // either way, since the same card's ability+moves belong to that same
    // real species too - the fallback isn't a worse answer for that case,
    // just a differently-derived one.
    const [textName, textConfidence] = spellCorrectNameConfidence(nameRaw, idToNameByLang.name, lang);
    if (textConfidence >= 1.0) {
      name = textName;
    } else {
      const movesetMatch = await identifyByAbilityAndMoves(ability, moves);
      name = movesetMatch || textName;
      if (!movesetMatch) {
        // Neither signal reached a confident unique answer - offer both
        // sets of candidates together (moveset-based first, since it's the
        // more reliable of the two when it has an opinion at all - see
        // movesetMatch.mjs), deduplicated, so a reviewer sees every
        // plausible species this card's actual data points to rather than
        // just one signal's guesses.
        const movesetCandidates = await identifyByAbilityAndMovesCandidates(ability, moves);
        const textCandidates = spellCorrectCandidates(nameRaw, "name", idToNameByLang.name, lang);
        const seen = new Set();
        const candidates = [];
        for (const c of [...movesetCandidates, ...textCandidates]) {
          if (seen.has(c.name)) continue;
          seen.add(c.name);
          candidates.push(c);
        }
        uncertain.push({ field: "name", value: name, candidates });
      }
    }
  }

  // Compared against the raw (untranslated) species text, not the
  // English-translated `name` - a custom mega stone's on-screen name
  // shares a prefix with the species name in whatever language the
  // screenshot is in, not with the English name.
  //
  // nameRaw is the nickname, not the species name, for a nicknamed
  // Pokemon - no amount of comparing against it will ever find that shared
  // prefix, since it isn't there (a real observed case: Floette-Eternal's
  // "フラエッテナイト" item compared against nickname "ヒガンバナ" shares
  // nothing, and fell through to matching a real, unrelated, wrong item
  // instead). When name was resolved via movesetMatch.mjs rather than by
  // reading real species text, retry the same check against that resolved
  // species' own native name instead - see baseNativeName.
  let megaStoneNameRaw = nameRaw;
  if (itemRaw && !looksLikeMegaStoneRaw(itemRaw, nameRaw, lang)) {
    const nativeName = baseNativeName(name, idToNameByLang.name, lang);
    if (nativeName && looksLikeMegaStoneRaw(itemRaw, nativeName, lang)) {
      megaStoneNameRaw = nativeName;
    }
  }

  let itemName;
  if (itemRaw && looksLikeMegaStone(slugify(itemRaw), slugify(nameRaw))) {
    itemName = formatName(slugify(itemRaw));
  } else if (itemRaw) {
    // Some of this game's custom mega stones are already present, correctly
    // spelled, in the bundled item data - confirmed for real: Blastoise and
    // Raichu's Champions-specific stones are there verbatim ("Blastoisinite",
    // "Raichunite X"/"Raichunite Y" - deliberately different spellings from
    // real mainline Pokemon's own "-ite" convention, not typos), while
    // Floette-Eternal's "Floettite" has no entry at all. A genuine database
    // match is always preferred over the mechanical "-ite" reconstruction
    // below, which exists only for the items that truly aren't in the
    // bundled data - checked first so a real hit never gets overridden by a
    // same-shaped guess. Confidence is what tells them apart: a real match
    // here (like either mega stone above) scores a clean 1.0, while a
    // coincidental wrong match against an unrelated real item (like
    // Floette-Eternal's raw text fuzzy-matching some other real stone)
    // scores well below that - same distinction spellCorrectNameConfidence
    // draws for nicknames above, applied here to items instead.
    const [dbItemName, itemConfidence] = translateToEnglishConfidence(
      itemRaw, idToNameByLang.item[lang], idToNameByLang.item.en, 0.5, "item"
    );
    if (itemConfidence >= 1.0) {
      itemName = formatName(slugify(dbItemName));
    } else if (looksLikeMegaStoneRaw(itemRaw, megaStoneNameRaw, lang)) {
      // slugify() is ASCII-only and would empty out non-Latin text, so
      // there's no raw suffix to format here the way the English branch
      // above does - reconstruct the name from the (already-translated)
      // English species name and the "-ite" convention instead, since
      // that's what a real mega stone's English name would look like
      // anyway. A trailing "e" is dropped before adding "-ite" (matching
      // real examples: Sceptile -> Sceptilite, Gardevoir -> Gardevoirite
      // has no such vowel to drop) since "-ite" already starts with a vowel.
      // A mega stone's name is always built from the *base* species name,
      // never a form-qualified one (e.g. "Floette-Eternal" -> "Floettite",
      // not "Floette-Eternalite") - the form suffix is stripped first.
      const baseName = name.split("-")[0];
      const stem = baseName.endsWith("e") ? baseName.slice(0, -1) : baseName;
      const variant = itemRaw.trim().match(/([XY])$/);
      itemName = `${stem}ite` + (variant ? ` ${variant[1]}` : "");
    } else {
      itemName = dbItemName !== null ? formatName(slugify(dbItemName)) : formatName(slugify(itemRaw));
      uncertain.push({
        field: "item",
        value: itemName,
        candidates: spellCorrectCandidates(itemRaw, "item", idToNameByLang.item, lang),
      });
    }
  } else {
    itemName = "";
  }

  let finalName = name;
  if (finalName === "Rotom") {
    const rotomForm = detectRotomForm(moves);
    if (rotomForm) finalName = `Rotom-${rotomForm}`;
  } else if (finalName === "Floette") {
    // Champions currently only has the Eternal Flower form available - the
    // base "Floette" pokedex.js entry can never actually be the right
    // answer, regardless of what item (if any) was read, so this doesn't
    // need to be conditioned on the Floettite item check the way a real
    // ambiguous case would be.
    finalName = "Floette-Eternal";
  } else {
    finalName = resolveFormSuffix(finalName);
  }

  return { name: finalName, ability, item: itemName, moves, uncertain };
}
